root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

# recorded and generated files are compared byte for byte: leave them as they are
[{fixtures/**,**/generated/**,native/kea-helper/src/limits.rs,patches/*.patch}]
trim_trailing_whitespace = false
insert_final_newline = unset
