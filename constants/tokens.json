{
  "$description": "Kea design tokens (W3C design-token format). The single home of every colour, size, space and radius in code. `pnpm codegen` writes packages/ui/src/generated/tokens.css, packages/ui/src/generated/tokens.ts, packages/terminal/src/generated/themes.ts, packages/protocol/src/generated/themes.ts (the theme list) and packages/ui/src/generated/syntax-theme.json.",
  "color": {
    "surface-0": { "$type": "color", "$value": "#0C0D0B", "$description": "Terminal canvas, diff viewer canvas (deepest)" },
    "surface-1": { "$type": "color", "$value": "#111210", "$description": "Sidebar, file tree, header bar" },
    "surface-2": { "$type": "color", "$value": "#181A16", "$description": "Row hover, inputs, inactive tabs" },
    "surface-3": { "$type": "color", "$value": "#20231E", "$description": "Selected row, pressed, active tab" },
    "surface-4": { "$type": "color", "$value": "#2A2D27", "$description": "Floating layers: menus, popovers, palette, tooltips" },
    "line": { "$type": "color", "$value": "#23261F", "$description": "Hairlines between panels" },
    "line-strong": { "$type": "color", "$value": "#33372F", "$description": "Input borders, floating layer outline" },
    "text-1": { "$type": "color", "$value": "#E6E8E1", "$description": "Primary text, selected rows" },
    "text-2": { "$type": "color", "$value": "#A3A79A", "$description": "Default row text, secondary labels" },
    "text-3": { "$type": "color", "$value": "#868A80", "$description": "Meta, timestamps, placeholders, ignored files" },
    "accent": { "$type": "color", "$value": "#F5793A", "$description": "Needs-you status, primary button, focus ring, terminal cursor" },
    "accent-hover": { "$type": "color", "$value": "#FF8D55", "$description": "Primary button hover" },
    "accent-wash": { "$type": "color", "$value": "rgba(245,121,58,.14)", "$description": "Background of an attention row / badge" },
    "on-accent": { "$type": "color", "$value": "#1A0E06", "$description": "Text on the primary button" },
    "ok": { "$type": "color", "$value": "#7FBF7A", "$description": "Server running, git added/untracked" },
    "warn": { "$type": "color", "$value": "#D9B45B", "$description": "Git modified, warnings" },
    "danger": { "$type": "color", "$value": "#EC6A57", "$description": "Errors, destructive, git deleted" },
    "info": { "$type": "color", "$value": "#7AA2D6", "$description": "Git renamed, links" }
  },
  "contrast": {
    "$description": "These text and semantic tokens must reach `min` on every listed surface (checked by DS-1).",
    "text": ["text-1", "text-2", "text-3", "accent", "ok", "warn", "danger", "info"],
    "surfaces": ["surface-1", "surface-2", "surface-3"],
    "min": 4.5
  },
  "terminalContrast": {
    "$description": "In every bundled terminal theme, these colours must reach `min` on the theme's background, the far greys of its colour scheme too, and its cursor `cursorMin` (checked by DS-7).",
    "text": ["foreground", "red", "green", "yellow", "blue", "magenta", "cyan", "brightRed", "brightGreen", "brightYellow", "brightBlue", "brightMagenta", "brightCyan"],
    "dark": ["white", "brightWhite"],
    "light": ["black", "brightBlack"],
    "min": 4.5,
    "cursorMin": 3
  },
  "terminal": {
    "kea-dark": {
      "$description": "Terminal theme \"Kea Dark\"",
      "$extensions": { "kea": { "label": "Kea Dark", "scheme": "dark" } },
      "background": { "$type": "color", "$value": "#0C0D0B" },
      "foreground": { "$type": "color", "$value": "#DADDD3" },
      "cursor": { "$type": "color", "$value": "#F5793A" },
      "cursorAccent": { "$type": "color", "$value": "#0C0D0B" },
      "selectionBackground": { "$type": "color", "$value": "#343A30" },
      "selectionInactiveBackground": { "$type": "color", "$value": "#262A23" },
      "black": { "$type": "color", "$value": "#1B1D19" },
      "red": { "$type": "color", "$value": "#EC6A57" },
      "green": { "$type": "color", "$value": "#7FBF7A" },
      "yellow": { "$type": "color", "$value": "#D9B45B" },
      "blue": { "$type": "color", "$value": "#7AA2D6" },
      "magenta": { "$type": "color", "$value": "#B58AD6" },
      "cyan": { "$type": "color", "$value": "#6FBFB5" },
      "white": { "$type": "color", "$value": "#C9CCC2" },
      "brightBlack": { "$type": "color", "$value": "#5A5E54" },
      "brightRed": { "$type": "color", "$value": "#F58B7A" },
      "brightGreen": { "$type": "color", "$value": "#9AD494" },
      "brightYellow": { "$type": "color", "$value": "#E8C97A" },
      "brightBlue": { "$type": "color", "$value": "#9BBCE6" },
      "brightMagenta": { "$type": "color", "$value": "#CBA6E6" },
      "brightCyan": { "$type": "color", "$value": "#8FD6CC" },
      "brightWhite": { "$type": "color", "$value": "#F2F4EC" }
    },
    "kea-light": {
      "$description": "Terminal theme \"Kea Light\": the bundled light theme",
      "$extensions": { "kea": { "label": "Kea Light", "scheme": "light" } },
      "background": { "$type": "color", "$value": "#F7F8F3" },
      "foreground": { "$type": "color", "$value": "#23261F" },
      "cursor": { "$type": "color", "$value": "#C9520F" },
      "cursorAccent": { "$type": "color", "$value": "#F7F8F3" },
      "selectionBackground": { "$type": "color", "$value": "#D5DACB" },
      "selectionInactiveBackground": { "$type": "color", "$value": "#E4E7DC" },
      "black": { "$type": "color", "$value": "#23261F" },
      "red": { "$type": "color", "$value": "#B3392A" },
      "green": { "$type": "color", "$value": "#3B7A36" },
      "yellow": { "$type": "color", "$value": "#8A6410" },
      "blue": { "$type": "color", "$value": "#2F65A8" },
      "magenta": { "$type": "color", "$value": "#7D4FA6" },
      "cyan": { "$type": "color", "$value": "#1F7A70" },
      "white": { "$type": "color", "$value": "#6E7267" },
      "brightBlack": { "$type": "color", "$value": "#5A5E54" },
      "brightRed": { "$type": "color", "$value": "#A32F21" },
      "brightGreen": { "$type": "color", "$value": "#2F6B2B" },
      "brightYellow": { "$type": "color", "$value": "#765509" },
      "brightBlue": { "$type": "color", "$value": "#255893" },
      "brightMagenta": { "$type": "color", "$value": "#6C4192" },
      "brightCyan": { "$type": "color", "$value": "#176A61" },
      "brightWhite": { "$type": "color", "$value": "#8A8E82" }
    }
  },
  "syntax": {
    "$description": "Syntax theme \"Kea Dark\": TextMate scope classes → colours named after the terminal palette and tokens; checked by DS-3 on surface-0.",
    "text": { "$value": "{terminal.kea-dark.foreground}", "scopes": ["variable", "variable.parameter", "meta.definition.variable", "source"] },
    "comment": { "$value": "{color.text-3}", "scopes": ["comment", "punctuation.definition.comment", "string.comment"] },
    "keyword": { "$value": "{terminal.kea-dark.magenta}", "scopes": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.operator.expression", "keyword.operator.logical.python"] },
    "string": { "$value": "{terminal.kea-dark.green}", "scopes": ["string", "string.quoted", "string.template", "punctuation.definition.string", "markup.inline.raw", "markup.fenced_code", "markup.raw", "markup.code"] },
    "escape": { "$value": "{terminal.kea-dark.cyan}", "scopes": ["constant.character", "constant.character.escape", "string.regexp", "constant.other.placeholder", "punctuation.definition.template-expression"] },
    "constant": { "$value": "{terminal.kea-dark.yellow}", "scopes": ["constant.numeric", "constant.language", "constant.language.boolean", "support.constant", "constant.other.color"] },
    "function": { "$value": "{terminal.kea-dark.blue}", "scopes": ["entity.name.function", "support.function", "meta.function-call entity.name.function", "variable.function"] },
    "type": { "$value": "{terminal.kea-dark.cyan}", "scopes": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class", "storage.type.class", "entity.name.namespace"] },
    "property": { "$value": "{terminal.kea-dark.brightBlue}", "scopes": ["variable.other.property", "variable.other.object.property", "meta.object-literal.key", "support.type.property-name", "entity.name.tag.yaml", "support.variable.property"] },
    "tag": { "$value": "{terminal.kea-dark.red}", "scopes": ["entity.name.tag", "punctuation.definition.tag", "support.class.component"] },
    "attribute": { "$value": "{terminal.kea-dark.yellow}", "scopes": ["entity.other.attribute-name"] },
    "operator": { "$value": "{color.text-2}", "scopes": ["keyword.operator", "punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator"] },
    "heading": { "$value": "{color.text-1}", "fontStyle": "bold", "scopes": ["markup.heading", "entity.name.section", "punctuation.definition.heading"] },
    "link": { "$value": "{terminal.kea-dark.blue}", "scopes": ["markup.underline.link", "string.other.link", "markup.link"] },
    "invalid": { "$value": "{color.danger}", "fontStyle": "underline", "scopes": ["invalid", "invalid.illegal", "invalid.deprecated"] }
  },
  "font": {
    "ui": { "$type": "fontFamily", "$value": "-apple-system, \"SF Pro Text\", system-ui, sans-serif" },
    "mono": { "$type": "fontFamily", "$value": "\"SF Mono\", ui-monospace, Menlo, monospace" }
  },
  "type": {
    "base": { "$type": "typography", "size": "13px", "line": "20px", "weight": 400 },
    "emphasis": { "$type": "typography", "size": "13px", "line": "20px", "weight": 500 },
    "secondary": { "$type": "typography", "size": "12px", "line": "18px", "weight": 400 },
    "micro": { "$type": "typography", "size": "11px", "line": "16px", "weight": 500 },
    "dialog": { "$type": "typography", "size": "15px", "line": "22px", "weight": 600 },
    "mono": { "$type": "typography", "size": "12px", "line": "18px", "weight": 400 }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px", "$description": "badges, kbd" },
    "md": { "$type": "dimension", "$value": "6px", "$description": "buttons, inputs, rows" },
    "lg": { "$type": "dimension", "$value": "10px", "$description": "dialogs, popovers, palette" }
  },
  "size": {
    "header": { "$type": "dimension", "$value": "44px" },
    "row": { "$type": "dimension", "$value": "28px" },
    "tree-row": { "$type": "dimension", "$value": "24px" },
    "tab-strip": { "$type": "dimension", "$value": "32px" },
    "palette-row": { "$type": "dimension", "$value": "32px" },
    "icon": { "$type": "dimension", "$value": "16px" },
    "icon-stroke": { "$type": "dimension", "$value": "1.5px", "$description": "icon stroke" },
    "glyph": { "$type": "dimension", "$value": "12px" },
    "dot": { "$type": "dimension", "$value": "5px" },
    "glyph-small": { "$type": "dimension", "$value": "8px", "$description": "the detached glyph's small dashed ring, inside the 12 px glyph box" },
    "sidebar": { "$type": "dimension", "$value": "240px" },
    "sidebar-min": { "$type": "dimension", "$value": "200px" },
    "sidebar-max": { "$type": "dimension", "$value": "360px" },
    "tree": { "$type": "dimension", "$value": "264px" },
    "tree-min": { "$type": "dimension", "$value": "200px" },
    "tree-max": { "$type": "dimension", "$value": "480px" },
    "main-min": { "$type": "dimension", "$value": "480px" },
    "palette": { "$type": "dimension", "$value": "560px" },
    "composer": { "$type": "dimension", "$value": "640px" },
    "composer-prompt-max": { "$type": "dimension", "$value": "240px", "$description": "the composer prompt grows to 12 lines of the base line height, then scrolls" },
    "divider-hit": { "$type": "dimension", "$value": "7px" },
    "window-min-width": { "$type": "dimension", "$value": "880px" },
    "window-min-height": { "$type": "dimension", "$value": "520px" },
    "window-default-width": { "$type": "dimension", "$value": "1440px", "$description": "first launch, before window bounds are remembered; clamped to the display's work area. Wide enough for the agent beside the work pane with both side columns open" },
    "window-default-height": { "$type": "dimension", "$value": "900px", "$description": "first launch, before window bounds are remembered; clamped to the display's work area" },
    "tree-autocollapse": { "$type": "dimension", "$value": "1040px" },
    "split-hysteresis": { "$type": "dimension", "$value": "48px", "$description": "one column becomes the split only once the main column holds the split's need plus this much, so a live resize does not flap" },
    "hairline": { "$type": "dimension", "$value": "1px", "$description": "a divider's line, drawn inside the column or pane to its right" },
    "focus-line": { "$type": "dimension", "$value": "2px", "$description": "the line under the strip or status row of the pane with the keyboard, in the split" },
    "traffic-light-x": { "$type": "dimension", "$value": "16px", "$description": "macOS only: native traffic lights inside the sidebar header: left inset" },
    "traffic-light-y": { "$type": "dimension", "$value": "15px", "$description": "macOS only: native traffic lights: top inset, centred in the 44 px header" },
    "traffic-lights": { "$type": "dimension", "$value": "80px", "$description": "macOS only: width the traffic lights take in the sidebar header (Linux reserves the Window Controls Overlay's own rectangle)" },
    "window-controls": { "$type": "dimension", "$value": "43px", "$description": "Linux only: the Window Controls Overlay's height, the 44 px header less its 1 px bottom line, which stays drawn under the controls" },
    "terminal-pad-x": { "$type": "dimension", "$value": "12px" },
    "terminal-pad-y": { "$type": "dimension", "$value": "8px" },
    "focus-ring": { "$type": "dimension", "$value": "1.5px" },
    "scrollbar": { "$type": "dimension", "$value": "8px" },
    "server-control": { "$type": "dimension", "$value": "136px", "$description": "the dev-server control's slot in the main header: the width of its widest state (`Exited 1` and `Restart`), so the diff stat on its left keeps its place when the control changes state" }
  },
  "shadow": {
    "float": { "$type": "shadow", "$value": "0 12px 32px rgba(0,0,0,.55), 0 0 0 1px var(--line-strong)" }
  },
  "motion": {
    "panel": { "$type": "duration", "$value": "140ms" },
    "float-in": { "$type": "duration", "$value": "80ms" },
    "spinner": { "$type": "duration", "$value": "1s" },
    "tooltip-delay": { "$type": "duration", "$value": "500ms" }
  },
  "opacity": {
    "folder-tint": { "$type": "number", "$value": 0.7 },
    "detached-dim": { "$type": "number", "$value": 0.6 },
    "numstat": { "$type": "number", "$value": 0.8 },
    "diff-line": { "$type": "number", "$value": 0.14 },
    "diff-word": { "$type": "number", "$value": 0.28 },
    "find-match": { "$type": "number", "$value": 0.25 }
  },
  "ratio": {
    "composer-top": { "$type": "number", "$value": 0.2, "$description": "the composer is top-aligned at 20 % of the pane height" }
  }
}
