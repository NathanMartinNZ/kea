{
  "$comment": "GENERATED by `pnpm codegen` from constants/: do not edit.",
  "name": "kea-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#0C0D0B",
    "editor.foreground": "#DADDD3"
  },
  "tokenColors": [
    {
      "name": "text",
      "scope": [
        "variable",
        "variable.parameter",
        "meta.definition.variable",
        "source"
      ],
      "settings": {
        "foreground": "#DADDD3"
      }
    },
    {
      "name": "comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#868A80"
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python"
      ],
      "settings": {
        "foreground": "#B58AD6"
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string",
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw",
        "markup.code"
      ],
      "settings": {
        "foreground": "#7FBF7A"
      }
    },
    {
      "name": "escape",
      "scope": [
        "constant.character",
        "constant.character.escape",
        "string.regexp",
        "constant.other.placeholder",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#6FBFB5"
      }
    },
    {
      "name": "constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "support.constant",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#D9B45B"
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#7AA2D6"
      }
    },
    {
      "name": "type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#6FBFB5"
      }
    },
    {
      "name": "property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.tag.yaml",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#9BBCE6"
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#EC6A57"
      }
    },
    {
      "name": "attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#D9B45B"
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#A3A79A"
      }
    },
    {
      "name": "heading",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#E6E8E1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "link",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "markup.link"
      ],
      "settings": {
        "foreground": "#7AA2D6"
      }
    },
    {
      "name": "invalid",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#EC6A57",
        "fontStyle": "underline"
      }
    }
  ]
}
